---

# Generic
generic:
  role: ansible-role-virtualbox
  role_short: virtualbox
  role_description: |
    Installs VirtualBox 7.0 including extension pack

# Supported platforms
platforms:
  sles15:
    supported: true
    ci: false
  sles16:
    supported: true
    ci: false
  opensuse15:
    supported: true
    ci: true
  opensuse16:
    supported: true
    ci: true
  debian13:
    supported: false
    ci: false

molecule:
  converge:
    vars:
      virtualbox_disble_gpg_check: true
